{
  "name": "atlas-of-the-universe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Interactive, scientifically grounded universe atlas (foundation).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && vite build",
    "data:import": "tsx tools/data-import.ts all",
    "data:gaia": "tsx tools/data-import.ts gaia",
    "data:simbad": "tsx tools/data-import.ts simbad",
    "data:report": "tsx tools/data-import.ts report",
    "data:rebuild": "tsx tools/data-import.ts all --offline",
    "qa:browser": "node tools/qa-browser.mjs",
    "data:solar": "tsx tools/solar-import.ts",
    "data:solar:offline": "tsx tools/solar-import.ts --offline",
    "textures:build": "python3 tools/textures/build_textures.py",
    "textures:annotate": "python3 tools/textures/build_textures.py --annotate-nodata",
    "qa:solar": "node tools/qa-solar.mjs",
    "data:objects": "tsx tools/deepspace/build_objects.ts",
    "data:objects:offline": "tsx tools/deepspace/build_objects.ts --offline",
    "data:deepspace:catalogues": "tsx tools/deepspace/build_catalogues.ts",
    "data:deepspace:catalogues:offline": "tsx tools/deepspace/build_catalogues.ts --offline",
    "deepspace:images": "python3 tools/deepspace/build_images.py",
    "deepspace:images:report": "python3 tools/deepspace/build_images.py --report",
    "credits:build": "node tools/deepspace/make_credits_page.mjs",
    "qa:deepspace": "node tools/qa-deepspace.mjs",
    "perf:deepspace": "node tools/perf-deepspace.mjs",
    "qa:discovery-api": "node tools/qa-discovery-api.mjs",
    "qa:discovery-ui": "node tools/qa-discovery-ui.mjs",
    "discovery:notes": "node tools/discovery/build_notes.mjs",
    "data:stars": "tsx tools/discovery/build_bright_stars.ts",
    "data:stars:offline": "tsx tools/discovery/build_bright_stars.ts --offline",
    "data:exoplanets": "tsx tools/discovery/build_exoplanets.ts",
    "data:exoplanets:offline": "tsx tools/discovery/build_exoplanets.ts --offline",
    "data:other": "tsx tools/discovery/build_other_objects.ts",
    "data:other:offline": "tsx tools/discovery/build_other_objects.ts --offline",
    "bench:spatial": "tsx tools/discovery/bench_spatial.ts"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
